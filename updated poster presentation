gs:\n","    model: The trained machine learning model.\n","    X_test: Test data (features).\n","    shap_values: SHAP values for the test data.\n","\n","  Returns:\n","    None. Prints insights and plots related to feature significance.\n","  \"\"\"\n","\n","  shap_values_avg = np.mean(shap_values, axis=2)  # Average across classes\n","  mean_abs_shap_values = np.mean(np.abs(shap_values_avg), axis=0)\n","  sorted_feature_indices = np.argsort(mean_abs_shap_values)[::-1]\n","\n","  # Filter out features with zero importance\n","  non_zero_indices = [i for i in sorted_feature_indices if mean_abs_shap_values[i] > 0]\n","\n","  plt.figure(figsize=(12, 6))\n","  bar_width = 0.2\n","  colors = ['red', 'green', 'blue']\n","\n","  for class_index in range(shap_values.shape[2]):\n","    class_shap_values = shap_values[:, :, class_index]\n","    class_mean_abs_shap_values = np.mean(np.abs(class_shap_values), axis=0)\n","    bar_positions = np.arange(len(non_zero_indices)) + (class_index * bar_width)\n","    plt.bar(bar_positions, class_mean_abs_shap_values[non_zero_indices], width=bar_width,\n","            label=f\"Class {class_index}\", color=colors[class_index])\n","\n","\n","  plt.xticks(np.arange(len(non_zero_indices)) + (bar_width * (shap_values.shape[2] - 1) / 2),\n","             [X_test.columns[i] for i in non_zero_indices], rotation=90)\n","  plt.title(\"Feature Importance based on Mean Absolute SHAP Values (Combined)\")\n","  plt.xlabel(\"Feature\")\n","  plt.ylabel(\"Mean Absolute SHAP Value\")\n","  plt.legend()\n","  plt.show()\n","\n","explainer = shap.TreeExplainer(modelxGB, X_test)\n","shap_values = explainer.shap_values(X_test)\n","analyze_shap_feature_significance(modelxGB, X_test, shap_values)\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":586},"id":"c2eAgRWN_CtC","executionInfo":{"status":"ok","timestamp":1728690940488,"user_tz":300,"elapsed":2035,"user":{"displayName":"Doyinsola Osobukola","userId":"09276538231865899029"}},"outputId":"a6207d00-e54d-4f6f-d038-e49acaafba13"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1200x600 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["import shap\n","import matplotlib.pyplot as plt\n","import numpy as np\n","\n","def analyze_shap_feature_significance(model, X_test, shap_values):\n","    \"\"\"\n","    Analyze SHAP feature significance for a given model and test data, with stacked bar chart representation.\n","\n","    Args:\n","        model: The trained machine learning model.\n","        X_test: Test data (features).\n","        shap_values: SHAP values for the test data.\n","\n","    Returns:\n","        None. Prints insights and plots related to feature significance.\n","    \"\"\"\n","    num_classes = shap_values.shape[2]\n","\n","    mean_abs_shap_values_per_class = np.mean(np.abs(shap_values), axis=0)  # Average across instances\n","    mean_abs_shap_values_total = np.sum(mean_abs_shap_values_per_class, axis=1)\n","    sorted_feature_indices = np.argsort(mean_abs_shap_values_total)[::-1]\n","    non_zero_indices = [i for i in sorted_feature_indices if mean_abs_shap_values_total[i] > 0]\n","\n","    plt.figure(figsize=(12, 6))\n","    colors = ['purple', 'blue', 'green']\n","\n","    bottom = np.zeros(len(non_zero_indices))\n","\n","    # Iterate over classes\n","    for class_index in range(num_classes):\n","        class_mean_abs_shap_values = mean_abs_shap_values_per_class[:, class_index]\n","        plt.bar(np.arange(len(non_zero_indices)),\n","                class_mean_abs_shap_values[non_zero_indices],\n","                bottom=bottom,\n","                label=f\"Class {class_index}\",\n","                color=colors[class_index])\n","\n","        # Update the bottom for the next stack\n","        bottom += class_mean_abs_shap_values[non_zero_indices]\n","\n","    plt.xticks(np.arange(len(non_zero_indices)),\n","               [X_test.columns[i] for i in non_zero_indices], rotation=90)\n","    plt.title(\"Feature Importance based on Mean Absolute SHAP Values\")\n","    plt.xlabel(\"Feature\")\n","    plt.ylabel(\"Mean Absolute SHAP Value\")\n","    plt.legend()\n","    plt.tight_layout()\n","    plt.show()\n","\n","#\n","explainer = shap.TreeExplainer(modelxGB, X_test)\n","shap_values = explainer.shap_values(X_test)\n","analyze_shap_feature_significance(modelxGB, X_test, shap_values)\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":627},"id":"Knkka61UBDbf","executionInfo":{"status":"ok","timestamp":1728696202063,"user_tz":300,"elapsed":1650,"user":{"displayName":"Doyinsola Osobukola","userId":"09276538231865899029"}},"outputId":"0254d4a6-6660-4bb6-ed46-7665bca79aa6"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1200x600 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["new_data.head()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":256},"id":"qyOjlusq7S7i","executionInfo":{"status":"ok","timestamp":1728689580309,"user_tz":300,"elapsed":360,"user":{"displayName":"Doyinsola Osobukola","userId":"09276538231865899029"}},"outputId":"861988ff-9ca7-4807-f955-6da28f7b4e48"},"execution_count":null,"outputs":[{"output_type":"execute_result","data":{"text/plain":["   Box_office  Tickets_sold    Budget  No_reviews       POS       NEG  \\\n","0   -0.665611     -0.675521 -0.768891    0.186548  0.168662  0.129200   \n","1    0.044421     -0.672216  0.720513    1.996353  2.544180  2.073998   \n","2   -0.396963     -0.671955  0.171142   -0.737359 -0.765252 -0.777256   \n","3   -0.691674     -0.668518 -0.195105   -0.674456 -0.677370 -0.747449   \n","4   -0.652575     -0.668512 -0.781100   -0.471971 -0.479605 -0.396087   \n","\n","    PNratio  WPNratio    Weight        PI  ...  Trailer_Year_2021  \\\n","0 -0.062514  0.742061  1.090060  0.254398  ...                  0   \n","1  0.298666  1.078959  1.090